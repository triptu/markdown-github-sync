{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cipher-vault-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-01",
  "durable_objects": {"bindings": [{"name": "VAULTS", "class_name": "Vault"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Vault"]}],
  "r2_buckets": [{"binding": "BLOBS", "bucket_name": "cipher-vault-sync"}]
}
