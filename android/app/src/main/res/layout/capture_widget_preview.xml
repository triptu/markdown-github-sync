<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for the capture bar. Mirrors quick/CaptureWidget.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_preview_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="17dp"
        android:paddingEnd="6dp">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ph_note_pencil"
            android:tint="@color/quick_ink2" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/capture_widget_label"
            android:textColor="@color/quick_muted"
            android:textSize="16sp" />
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_mic">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ph_microphone"
                android:tint="@color/quick_bg" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
