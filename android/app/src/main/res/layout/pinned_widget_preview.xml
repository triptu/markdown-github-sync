<?xml version="1.0" encoding="utf-8"?>
<!-- What the widget picker shows for the pinned-note widget. Mirrors quick/PinnedNoteWidget.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="14dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/pinned_preview_title"
        android:textColor="@color/quick_ink"
        android:textSize="16sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/widget_task_done"
        android:gravity="center_vertical"
        android:text="@string/pinned_preview_done"
        android:textColor="@color/quick_muted"
        android:textSize="15sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/widget_task_open"
        android:gravity="center_vertical"
        android:text="@string/pinned_preview_open"
        android:textColor="@color/quick_ink"
        android:textSize="15sp" />
</LinearLayout>
