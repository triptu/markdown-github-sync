  "narrative": {
    "northStar": "The Field Report",
    "overview": "The page is a printed technical brief on warm paper: a serif editorial voice for headings, a quiet sans for explanation, and deep forest green for anything that represents committed, authoritative state. Amber marks what is local, unresolved, or synthetic. Density is moderate: generous section rhythm (104px) with compact 11–13px labels inside diagrams.\n\nDepth comes from tonal panels and hairline rules rather than shadows. Explanations are built from diagrams and concrete states (device-to-repo map, four-phase transaction strip, conflict resolver demo), not decorative imagery.",
    "keyCharacteristics": [
      "Warm off-white paper ground with green-ink text; light scheme only.",
      "Newsreader serif headlines, DM Sans for everything else.",
      "Green = committed/authoritative; amber = draft, conflict, or demo.",
      "Hairline `line` rules divide content; tonal green panels group it.",
      "Bounded 1240px container; reading paragraphs capped around 420–510px."
    ],
    "rules": [
      {
        "name": "The Authority Color Rule",
        "body": "Solid green fill means \"this is the committed/shared version or the selected action.\" Don't use it for decoration.",
        "section": "colors"
      },
      {
        "name": "The Synthetic Is Amber Rule",
        "body": "Demo, draft, and conflict states are labelled in amber so illustrative content is never mistaken for real vault data.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Serif is for headings and for depicted note content; never for UI controls or labels.",
        "section": "typography"
      },
      {
        "name": "The Paper-Only Shadow Rule",
        "body": "Shadows belong to depicted documents, not to UI panels or buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use forest green fill only for committed authority and selected actions.",
      "**Do** label every synthetic example with amber demo/draft styling.",
      "**Do** separate content with 1px `line` hairlines and tonal panels.",
      "**Do** keep reading paragraphs within ~420–510px inside the 1240px container."
    ],
    "donts": [
      "**Don't** treat these tokens as the Obsidian plugin's UI or an approved brand.",
      "**Don't** add shadows to panels or buttons; the paper-sheet shadow is the only one.",
      "**Don't** use Newsreader for controls, labels, or captions."
    ]
  }
